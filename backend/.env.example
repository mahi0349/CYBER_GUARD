# CYBERGUARD Configuration
PROJECT_NAME=CYBERGUARD
VERSION=1.0.0
ENVIRONMENT=development
API_V1_STR=/api/v1

# Database configuration (Postgres with auto SQLite fallback)
DATABASE_URL=sqlite:///./cyberguard.db
# To use Docker PostgreSQL, uncomment:
# DATABASE_URL=postgresql://cyberguard:cyberguard_secure_password@localhost:5432/cyberguard

# Security / JWT
SECRET_KEY=cyberguard_hackathon_super_secret_jwt_key_992182
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / LLM Configuration
# Set your Gemini API key for dynamic LLM threat reasoning
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Risk Policy Thresholds
RISK_THRESHOLD_LOW=20
RISK_THRESHOLD_MEDIUM=40
RISK_THRESHOLD_HIGH=60
RISK_THRESHOLD_CRITICAL=80
